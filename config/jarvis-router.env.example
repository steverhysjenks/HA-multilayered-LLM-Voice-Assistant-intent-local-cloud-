# Jarvis Router environment file
#
# Install the real file as:
#   /etc/jarvis-router.env
#
# Recommended permissions:
#   chmod 600 /etc/jarvis-router.env
#
# NEVER COMMIT THE REAL VALUES.

# LiteLLM master or virtual key used by jarvis-route to call qwen-local.
LITELLM_MASTER_KEY=replace-me

# Home Assistant base URL.
# Example:
# HA_URL=http://192.168.0.10:8123
HA_URL=http://HOME_ASSISTANT_IP:8123

# Home Assistant long-lived access token.
HA_TOKEN=replace-me

# Bearer token used by the HA custom component when calling /route.
# Generate, for example:
#   openssl rand -hex 32
ROUTER_API_KEY=replace-me
